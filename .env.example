# Validated at startup by src/config/env.schema.ts (Stage 1).
NODE_ENV=development
PORT=3300

# Minimum 32 characters. Never commit a real key.
API_KEY=replace-with-a-random-key-of-at-least-32-characters

# Defaults to false when omitted. Only 'true' or 'false' are accepted.
SWAGGER_ENABLED=true

# Global request timeout (RxJS). It does not cancel in-flight persistence.
REQUEST_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Persistence (Stage 2). Optional for the HTTP foundation; the MongoDB and
# DynamoDB modules, `npm run infra:init` and the integration tests require them.
# ---------------------------------------------------------------------------
# MongoDB replica set published by docker-compose.yml (required by the Mongo module).
MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGO_DB_NAME=external_validation
# serverSelectionTimeoutMS / connectTimeoutMS. Does not cut running transactions.
MONGO_TIMEOUT_MS=5000

# DynamoDB Local. Mandatory outside production so a missing value can never
# reach a real AWS account; init and integration tests accept only a local host.
DYNAMODB_ENDPOINT=http://127.0.0.1:8001
DYNAMODB_TABLE=validation_audit
# Per attempt (connection and request); the SDK makes at most 2 attempts.
DYNAMODB_TIMEOUT_MS=2000

# Fake credentials for DynamoDB Local. Never put real AWS credentials here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------------------------------------------------------------------------
# REST Countries v5 (Stage 3). Optional for the HTTP foundation; the
# enrichment module requires REST_COUNTRIES_API_KEY when it is instantiated.
# ---------------------------------------------------------------------------
# Defaults to the value below when omitted.
REST_COUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5
# Provider key (sent as "Authorization: Bearer"). Different from API_KEY, which
# protects this service. Get one at https://restcountries.com/sign-up and never
# commit it. 'rc_live_demo' only returns a fixed sample, not real data.
REST_COUNTRIES_API_KEY=replace-with-your-rest-countries-api-key
# Per provider request. Keep it below REQUEST_TIMEOUT_MS.
HTTP_TIMEOUT_MS=5000
